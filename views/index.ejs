<!DOCTYPE html>

<!-- root element -->
<html lang = "en">

    <!-- head element -->
    <head >
        <!-- webpage title -->
        <title>
            Blogville
        </title>

        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <!-- linking bootstrap document -->
         
        <link rel="stylesheet"  href="styles.css" >
        
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
        
    </head>

    <!-- body section -->
    
    <div class="container-fluid full-width-bg bg-dark bg-gradient p-5 text-white ">
        <div class = "container " id = "header">
            <div class = "row font-effect-3d-float ">
                <h1 >Unique Blog Website!</h1>
            </div>
            <hr>
        </div>
    </div>
    <br>
    <body class="d-flex flex-column min-vh-100 justify-content-center">
        <%if (locals.signed_in) { %>
            <div class="row mx-auto">
                <h4>Welcome <%=username%>!</h4>
            </div>
            
        <% } %>
    
        <div class="mx-auto">
            <%if (locals.signed_in) { %>
                <form action="/create_page" method="GET" style="display:inline;">
                    <button id = "createPostBtn" class="btn btn-dark"> Create new blog:</button>
                </form>
            <% } %>
            <form action="/sign_up" method="GET" style="display:inline;">
                <button class="btn btn-primary" type="submit">Sign up:</button>
            </form>
            <form action="/sign_in" method="GET" style="display:inline;">
                <button class="btn btn-primary" type="submit">Login:</button>
            </form>
            <%if (locals.signed_in) { %>
                <form action="/logout" method="GET" style="display:inline;">
                    <button class="btn btn-danger" type="submit">Log out:</button>
                </form>
            <% } %>
            </div>
        <br>
        <div class = "container">  
            <%(console.log(locals.blogRows))%>
            <%if (locals.blogRows) { %>
                <h2> Blog posts:</h2>
                <%blogRows.forEach(row => {%>
                    
                    <div class="d-flex flex-row text-left" id ='postDiv'>
                        <div class = "d-flex flex-column">
                            <h2>Blog title: <%=row.title %></h2>
                            <h3>Blog Author: <%=row.creator_user_id %></h3>
                            <h4>Date created: <%=row.date_created%></h4>
                            <% if (row.body) {%>
                                <h5 id = 'blogText'><%=row.body %></h5>
                            <% } %>
                        </div>
                        <div class = "ms-auto">
                            
                            <%if (locals.username === row.creator_user_id) { %>
                                <form action="/delete" method="POST" style="display:inline;">
                                    <input type="hidden" name="deleteId" value="<%=row.blog_id%>">
                                    <button type="submit" class="btn btn-danger" >Delete</button>
                                </form>

                                <form action="/edit" method="POST" style="display:inline;">
                                    <input type="hidden" name="postId" value="<%=row.blog_id%>">
                                    <button id="editBtn" class="btn btn-primary" type="submit">Edit</button>
                                </form>
                            <%}%>
                        </div>
                    </div>
                <%});%>
            <% } %>
            <br>
        </div>

        <div class="mt-auto bg-dark bg-gradient p-5 text-white ">
            <div class = "container-fluid" id = "footer">
                <div class = "row font-effect-3d-float ">
                    <h2 ></h2>
                </div>
                <hr>
            </div>
        </div>
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" crossorigin="anonymous"></script>
        <script src="/app.js"></script>
    </body>   
    
</html>